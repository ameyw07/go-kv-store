    "version": "0.2.0",
    "configurations": [
        {
      "name": "Run inside Dev Container",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "ENV": "dev",
        "CGO_ENABLED": "0"
      },
      "buildFlags": [
  "-gcflags=all=-N -l"
],
"stopOnEntry": true
    },
    ]
}